+/*
+ * Lists the IPv4 addresses mDNS must answer on, default interface first.
+ * Windows: every adapter that is up, including ones without a gateway such as the
+ * "Microsoft Wi-Fi Direct Virtual Adapter" used by Mobile Hotspot (192.168.137.1),
+ * so that iPhones connected to the PC's hotspot can discover the receiver.
+ * Other platforms: unchanged (default interface only).
+ */
+static int mdns_get_ipv4_list(uint32_t *addrs, int max)
+{
+    int count = 0;
+    addrs[count++] = mdns_get_default_ipv4();
+#ifdef _WIN32
+    ULONG buflen = 15000;
+    PIP_ADAPTER_ADDRESSES pAddresses = (IP_ADAPTER_ADDRESSES *) malloc(buflen);
+    DWORD dwRetVal;
+
+    if (!pAddresses) {
+        return count;
+    }
+    dwRetVal = GetAdaptersAddresses(AF_INET, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST, NULL, pAddresses, &buflen);
+    if (dwRetVal == ERROR_BUFFER_OVERFLOW) {
+        free(pAddresses);
+        pAddresses = (IP_ADAPTER_ADDRESSES *) malloc(buflen);
+        if (!pAddresses) {
+            return count;
+        }
+        dwRetVal = GetAdaptersAddresses(AF_INET, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST, NULL, pAddresses, &buflen);
+    }
+    if (dwRetVal == NO_ERROR) {
+        for (PIP_ADAPTER_ADDRESSES a = pAddresses; a && count < max; a = a->Next) {
+            if (a->OperStatus != IfOperStatusUp || a->IfType == IF_TYPE_SOFTWARE_LOOPBACK ||
+                wcsstr(a->Description, L"Hyper-V") || wcsstr(a->Description, L"WSL") ||
+                wcsstr(a->Description, L"vEthernet")) {
+                continue;
+            }
+            for (PIP_ADAPTER_UNICAST_ADDRESS u = a->FirstUnicastAddress; u && count < max; u = u->Next) {
+                uint32_t addr = ((struct sockaddr_in *) u->Address.lpSockaddr)->sin_addr.s_addr;
+                const unsigned char *b = (const unsigned char *) &addr;
+                int known = 0;
+                if (b[0] == 169 && b[1] == 254) {
+                    continue;   /* link-local (APIPA): adapter not really connected */
+                }
+                for (int i = 0; i < count; i++) {
+                    known |= (addrs[i] == addr);
+                }
+                if (!known) {
+                    addrs[count++] = addr;
+                }
+            }
+        }
+    }
+    free(pAddresses);
+    if (count > 1 && addrs[0] == 0) {   /* no default found: drop the INADDR_ANY placeholder */
+        memmove(addrs, addrs + 1, (size_t) (count - 1) * sizeof(*addrs));
+        count--;
+    }
+#else
+    (void) max;
+#endif
+    return count;
+}
+
+static void mdns_use_iface4_locked(mdnsd_t *mdnsd, int i)
+{
+    mdnsd->ipv4_addr = mdnsd->iface4_addr[i];
+    mdnsd->sock_fd4 = mdnsd->iface4_fd[i];
+}
